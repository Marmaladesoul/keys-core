(* Kind separation when one code meets both kinds.

   The exchange's associated data is empty for both kinds, so the kind in
   CI is the only thing in the exchange that tells a device pairing from a
   Person pairing. The full world never offers one code to runs of both
   kinds, so separation.pv can't show whether that is enough. Here every
   code is displayed and typed by a device run and a Person run at once,
   and the attacker may guess it. *)

query c1: code, c2: code, p1: bitstring, p2: bitstring, k: aeadkey, j1: aeadkey, j2: aeadkey;

  (* C1. K1 of separation.pv: a displaying and a typing side that hold the
     same key agree on everything, the kind included. No exception. *)
  event(DisplayKeys(c1, p1, k, j1)) && event(TypeKeys(c2, p2, k, j2)) ==> c1 = c2 && p1 = p2;

  (* C2. EXPECTED FALSE: a typing side does accept a run in this world. *)
  event(TypeKeys(c1, p1, k, j1)) ==> false.

process
  ! new idsk: skey; new recsk: skey; new encsk: xsk;
    new displayEsk: esk; new typeEsk: esk;
    let cred = personCred(idsk, spk(recsk), xpk(encsk)) in
    out(net, (spk(idsk), spk(recsk), xpk(encsk), epk(displayEsk), epk(typeEsk)));
    ! new c: code;
      ( Display(personFlow, c, displayEsk, cred, nothing)
      | (! Type(personFlow, c, typeEsk, cred, nothing))
      | Display(deviceNewDisplays, c, displayEsk, deviceCred, nothing)
      | (! Type(deviceTrustedDisplays, c, typeEsk, deviceCred, nothing))
      | LuckyGuess(net, c) )
