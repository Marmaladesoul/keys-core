(* Kind separation, role separation and no reflection, stated on the
   session keys. None of these has an exception: they hold even for runs
   whose code the attacker guessed or was shown. Same world as
   agreement.pv. *)

query c1: code, c2: code, p1: bitstring, p2: bitstring,
      k: aeadkey, j1: aeadkey, j2: aeadkey;

  (* K1. A displaying side and a typing side that hold the same key ran
     with the same code and agree on everything: kind, each endpoint id in
     its role, sid, shares. So a device run never completes against a
     Person run, and neither side can be mistaken about who displayed. *)
  event(DisplayKeys(c1, p1, k, j1)) && event(TypeKeys(c2, p2, k, j2)) ==> c1 = c2 && p1 = p2;

  (* K2-K3. Two runs in the same role never hold the same key: no run is
     reflected onto another of the same role. *)
  event(DisplayKeys(c1, p1, k, j1)) && event(DisplayKeys(c2, p2, k, j2)) ==> p1 = p2;
  event(TypeKeys(c1, p1, k, j1)) && event(TypeKeys(c2, p2, k, j2)) ==> p1 = p2;

  (* K4-K6. A display-to-type key is never anybody's type-to-display key:
     a frame can't be turned round. *)
  event(DisplayKeys(c1, p1, k, j1)) && event(DisplayKeys(c2, p2, j2, k)) ==> false;
  event(DisplayKeys(c1, p1, k, j1)) && event(TypeKeys(c2, p2, j2, k)) ==> false;
  event(TypeKeys(c1, p1, k, j1)) && event(TypeKeys(c2, p2, j2, k)) ==> false.

process
  new shut: channel;
  World(net, net, shut, net)
