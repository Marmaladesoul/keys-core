(* The keys-pairing exchange, its payload flows and the world they run in.

     typing (T)                                displaying (D)
     Hello   { version, kind, nonce_T }   -->
                                          <--  Share   { nonce_D, Y_D }
     Reply   { Y_T, tag_T }               -->
                                          <--  Confirm { tag_D }

   The exchange's associated data is empty for both kinds. Loaded after
   primitives.pvl, one transport library and one binding library.

   Fresh names are written `new n[x, ...]`, which tells ProVerif which
   earlier values tell two instances of the name apart. Left to itself it
   uses every message received so far, whole, and the terms grow until the
   run takes minutes. Any choice here is sound (ProVerif can only lose
   precision by it and fail to prove something, never prove something
   false); these are the smallest that keep every proof. In particular the
   typing side's scalar must be told apart by the share it answers: without
   that ProVerif merges two runs of one typing side and reports a
   reflection of its own share and tag that no real run allows, because a
   scalar is drawn fresh for each run and only after the Share arrives. *)

(* ─── kinds and key sets ──────────────────────────────────────────────── *)

letfun kindOf(cred: bitstring) =
  let personCred(idsk, recpk, encpk) = cred in person else device.

(* The identity key's signature over this side's key set, bound to the run
   by whatever the binding library chooses. *)
letfun keySetSignature(idsk: skey, recpk: pkey, encpk: pkey, r: role,
                       ci: bitstring, sessionId: bitstring, yD: G, yT: G) =
  sign(idsk, keySetMsg(keySetBinding(r, ci, sessionId, yD, yT), spk(idsk), recpk, encpk)).

(* Opens the other side's key-set frame and returns the account it names.
   Fails (and so ends the flow) on a frame of the wrong shape or a bad
   signature.

   A side may also hold an expected identity for the other account and
   refuse a different one. The model leaves that check out, which is the
   most permissive setting: a side that holds an expectation records a
   subset of what is recorded here, so every property proven without the
   check holds with it. *)
letfun checkKeySet(r: role, ci: bitstring, sessionId: bitstring, yD: G, yT: G,
                   frame: bitstring) =
  let keySet(idpk, recpk, encpk, sig) = frame in
  if checksign(idpk, keySetMsg(keySetBinding(r, ci, sessionId, yD, yT), idpk, recpk, encpk), sig) = true then
  peerAccount(idpk, recpk, encpk).

(* ─── the displaying side ─────────────────────────────────────────────── *)

(* One run, with one code. `own` is what this side brings to the payload
   stage: a trusted device's `trustedSide`, a new device's `deviceKeys`, or
   `nothing` for a Person pairing. *)
let Display(f: flow, c: code, ownEsk: esk, cred: bitstring, own: bitstring) =
  let k = kindOf(cred) in
  let ownEp = epk(ownEsk) in
  (* Hello, from whichever endpoint the transport reports. *)
  in(net, (typeEp: ep, m1: bitstring, a1: bitstring));
  if transportAccepts(typeEp, ownEp, m1, a1) = true then
  let hello(=v1, =k, nT) = m1 in
  new nD[c, ownEsk, typeEp, nT]: nonce;
  new y[c, ownEsk, typeEp, nT]: scalar;
  let ci = mkci(v1, k, ownEp, typeEp) in
  let sessionId = mksid(nT, nD) in
  let yD = exp(h2c(c, ci, sessionId), y) in
  out(net, wrap(ownEsk, typeEp, share(nD, yD)));
  (* Reply, from the run's own peer only. *)
  in(net, (=typeEp, m3: bitstring, a3: bitstring));
  if transportAccepts(typeEp, ownEp, m3, a3) = true then
  let reply(yT, tagT) = m3 in
  let i = hisk(sessionId, dh(yT, y), yD, emptyAD, yT, emptyAD) in
  let mk = hmackey(sessionId, i) in
  (* D checks T's tag before it sends its own. *)
  if tagT = hmac(mk, yT, emptyAD) then
  let p = params(k, ownEp, typeEp, sessionId, yD, yT) in
  let kSend = sessionKey(i, displayToType) in
  let kRecv = sessionKey(i, typeToDisplay) in
  event DisplayAccepted(c, p);
  event DisplayKeys(c, p, kSend, kRecv);
  out(net, wrap(ownEsk, typeEp, confirm(hmac(mk, yD, emptyAD))));
  (* The displaying side speaks second: it seals nothing until it has opened
     a frame from the typing side. *)
  in(net, frame0: bitstring);
  let first = adec(kRecv, seq0, frame0) in
  if f = deviceTrustedDisplays then (
    (* A trusted device enrols only what is shaped as a new device's public
       keys. *)
    let trustedSide(idsk, b) = own in
    let deviceKeys(signing, relay, vault, author) = first in
    event Enrolled(c, p, first);
    out(net, sign(idsk, enrolment(first)));
    event BundleSent(c, p, b);
    out(net, aead(kSend, seq0, b))
  ) else if f = deviceNewDisplays then (
    if first = opening then
    event KeysSent(c, p, own);
    out(net, aead(kSend, seq0, own));
    in(net, frame1: bitstring);
    let b = adec(kRecv, seq1, frame1) in
    (* A new device installs only what is shaped as a bundle. *)
    let bundle(idsk, encsk, recpk, fleetTicket, fleetKey) = b in
    event Installed(c, p, b);
    event Completed(f)
  ) else (
    (* Person pairing. The typing side's key set came first; record the
       account only once its signature verifies, then answer with this
       side's own. *)
    let personCred(idsk, recpk, encpk) = cred in
    let peer = checkKeySet(roleType, ci, sessionId, yD, yT, first) in
    event DisplayRecorded(c, p, peer, kSend, kRecv);
    let sig = keySetSignature(idsk, recpk, encpk, roleDisplay, ci, sessionId, yD, yT) in
    event KeySetSent(c, p, roleDisplay, spk(idsk), recpk, encpk);
    event KeySetSigned(c, spk(idsk), sig);
    out(net, aead(kSend, seq0, keySet(spk(idsk), recpk, encpk, sig)));
    (* Then the friendship from the inviter, and this side's profile. *)
    in(net, frame1: bitstring);
    let second = adec(kRecv, seq1, frame1) in
    let friendship(ticket, pairwise) = second in
    event FriendshipInstalled(c, p, second);
    new name[c, ownEsk]: bitstring;
    event ProfileSent(c, p, profile(name));
    out(net, aead(kSend, seq1, profile(name)))
  ).

(* ─── the typing side ─────────────────────────────────────────────────── *)

let Type(f: flow, c: code, ownEsk: esk, cred: bitstring, own: bitstring) =
  let k = kindOf(cred) in
  let ownEp = epk(ownEsk) in
  (* Discovery is not trusted: the attacker picks the endpoint T dials. *)
  in(net, displayEp: ep);
  new nT[c, ownEsk, displayEp]: nonce;
  out(net, wrap(ownEsk, displayEp, hello(v1, k, nT)));
  in(net, (=displayEp, m2: bitstring, a2: bitstring));
  if transportAccepts(displayEp, ownEp, m2, a2) = true then
  let share(nD, yD) = m2 in
  let ci = mkci(v1, k, displayEp, ownEp) in
  let sessionId = mksid(nT, nD) in
  new y[c, ownEsk, displayEp, nD, yD]: scalar;
  let yT = exp(h2c(c, ci, sessionId), y) in
  let i = hisk(sessionId, dh(yD, y), yD, emptyAD, yT, emptyAD) in
  let mk = hmackey(sessionId, i) in
  let p = params(k, displayEp, ownEp, sessionId, yD, yT) in
  event TypeReplied(c, p);
  (* T's tag goes out before it has seen any proof from D. *)
  out(net, wrap(ownEsk, displayEp, reply(yT, hmac(mk, yT, emptyAD))));
  in(net, (=displayEp, m4: bitstring, a4: bitstring));
  if transportAccepts(displayEp, ownEp, m4, a4) = true then
  let confirm(tagD) = m4 in
  if tagD = hmac(mk, yD, emptyAD) then
  let kSend = sessionKey(i, typeToDisplay) in
  let kRecv = sessionKey(i, displayToType) in
  event TypeAccepted(c, p);
  event TypeKeys(c, p, kRecv, kSend);
  if f = deviceTrustedDisplays then (
    (* T is the new device. *)
    event KeysSent(c, p, own);
    out(net, aead(kSend, seq0, own));
    in(net, frame0: bitstring);
    let b = adec(kRecv, seq0, frame0) in
    let bundle(idsk, encsk, recpk, fleetTicket, fleetKey) = b in
    event Installed(c, p, b);
    event Completed(f)
  ) else if f = deviceNewDisplays then (
    (* T is the trusted device. It must speak first, so it opens with a
       fixed frame, then enrols what comes back and sends the bundle. *)
    let trustedSide(idsk, b) = own in
    out(net, aead(kSend, seq0, opening));
    in(net, frame0: bitstring);
    let dk = adec(kRecv, seq0, frame0) in
    let deviceKeys(signing, relay, vault, author) = dk in
    event Enrolled(c, p, dk);
    out(net, sign(idsk, enrolment(dk)));
    event BundleSent(c, p, b);
    out(net, aead(kSend, seq1, b))
  ) else (
    (* Person pairing. Both confirmations have verified, so this side's key
       set goes first; the displaying side's comes back, and the account is
       recorded only once its signature verifies. *)
    let personCred(idsk, recpk, encpk) = cred in
    let sig = keySetSignature(idsk, recpk, encpk, roleType, ci, sessionId, yD, yT) in
    event KeySetSent(c, p, roleType, spk(idsk), recpk, encpk);
    event KeySetSigned(c, spk(idsk), sig);
    out(net, aead(kSend, seq0, keySet(spk(idsk), recpk, encpk, sig)));
    in(net, frame0: bitstring);
    let peer = checkKeySet(roleDisplay, ci, sessionId, yD, yT, adec(kRecv, seq0, frame0)) in
    event TypeRecorded(c, p, peer, kRecv, kSend);
    (* Only then the friendship: the inviter creates it and sends its
       bootstrap; the invitee answers with its profile. *)
    new ticket[c, ownEsk]: bitstring;
    new pairwise[c, ownEsk]: aeadkey;
    event FriendshipSecrets(c, ticket, pairwise);
    event FriendshipSent(c, p, friendship(ticket, pairwise));
    out(net, aead(kSend, seq1, friendship(ticket, pairwise)));
    in(net, frame1: bitstring);
    let profile(name) = adec(kRecv, seq1, frame1) in
    event ProfileInstalled(c, p, profile(name));
    event Completed(f)
  ).

(* ─── what the attacker may learn about a code ────────────────────────── *)

(* Each lever is open when the world is given the public channel for it and
   shut when given a private one. *)

(* While the code is live the attacker may make one correct online guess,
   which is recorded. *)
let LuckyGuess(luckyGate: channel, c: code) =
  in(luckyGate, =go); event Lucky(c); out(net, c).

(* The attacker is the counterparty this code was meant for: the person
   displaying it shows it to the attacker. *)
let ShownToAdversary(toldGate: channel, c: code) =
  in(toldGate, =go); event AdversaryPeer(c); out(net, c).

(* Once every run of the first phase is over, the code becomes public. *)
let LeakedAfterUse(leakGate: channel, c: code) =
  phase 1; in(leakGate, =go); out(net, c).

(* ─── the world ───────────────────────────────────────────────────────── *)

(* Every device of every honest account that can take part in a Person
   pairing: its account's identity private key, recovery and encryption
   public keys, and its endpoint key. *)
table personDevices(skey, pkey, pkey, esk).

(* One trusted device and one new device, pairing any number of times in
   both directions. Each code feeds exactly one displaying run, by
   construction: that is an assumption about the caller (the sheet), not
   something proven here. The typing side may start any number of runs
   with the code it was told. *)
let DeviceCeremonies(luckyGate: channel, leakGate: channel, idpk: pkey,
                     trusted: bitstring, trustedEsk: esk, newEsk: esk, newKeys: bitstring) =
    (! new c: code; event TrustedCode(idpk, c);
       ( Display(deviceTrustedDisplays, c, trustedEsk, deviceCred, trusted)
       | (! Type(deviceTrustedDisplays, c, newEsk, deviceCred, newKeys))
       | LuckyGuess(luckyGate, c) | LeakedAfterUse(leakGate, c) ))
  | (! new c: code; event TrustedCode(idpk, c);
       ( Display(deviceNewDisplays, c, newEsk, deviceCred, newKeys)
       | (! Type(deviceNewDisplays, c, trustedEsk, deviceCred, trusted))
       | LuckyGuess(luckyGate, c) | LeakedAfterUse(leakGate, c) )).

(* An honest account with any number of devices, each pairing with any
   number of new devices. `ltGate` open lets the attacker take the
   account's long-term secrets, as a compromised device of the account
   would give them up. *)
let Account(luckyGate: channel, leakGate: channel, ltGate: channel) =
  new idsk: skey;
  new encsk: xsk;
  new recsk: skey;
  new fleetKey: aeadkey;
  new fleetTicket: bitstring;
  let idpk = spk(idsk) in
  let trusted = trustedSide(idsk, bundle(idsk, encsk, spk(recsk), fleetTicket, fleetKey)) in
  event HonestAccount(idpk);
  event AccountSecrets(idpk, idsk, encsk, fleetKey, fleetTicket);
  out(net, (idpk, spk(recsk), xpk(encsk)));
  ( (in(ltGate, =go); event LongTermLeaked(idpk);
     out(net, (idsk, encsk, fleetKey, fleetTicket)))
  | (! new trustedEsk: esk;
       out(net, epk(trustedEsk));
       insert personDevices(idsk, spk(recsk), xpk(encsk), trustedEsk);
       ! new newEsk: esk;
         new dsk: skey; new rsk: xsk; new vsk: xsk; new author: bitstring;
         let newKeys = deviceKeys(spk(dsk), xpk(rsk), xpk(vsk), author) in
         out(net, (epk(newEsk), newKeys));
         DeviceCeremonies(luckyGate, leakGate, idpk, trusted, trustedEsk, newEsk, newKeys)) ).

(* Person pairings: an honest device displays a code, and any honest
   devices (of any account, the displaying one included) type it, any
   number of times. That is more than a real ceremony allows, where one
   inviter is told the code, and it is deliberate: with `toldGate` open the
   attacker is the counterparty the code was shown to, and then it is the
   attacker who tells honest inviters what to type. A code the attacker
   made up itself is that case with the displaying run ignored. *)
let PersonCeremonies(luckyGate: channel, toldGate: channel, leakGate: channel) =
  ! get personDevices(idD, recD, encD, eskD) in
    new c: code;
    ( Display(personFlow, c, eskD, personCred(idD, recD, encD), nothing)
    | (! get personDevices(idT, recT, encT, eskT) in
         Type(personFlow, c, eskT, personCred(idT, recT, encT), nothing))
    | LuckyGuess(luckyGate, c) | ShownToAdversary(toldGate, c) | LeakedAfterUse(leakGate, c) ).

let World(luckyGate: channel, toldGate: channel, leakGate: channel, ltGate: channel) =
    (! Account(luckyGate, leakGate, ltGate))
  | PersonCeremonies(luckyGate, toldGate, leakGate).
