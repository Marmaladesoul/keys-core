(* Attack witnesses. EVERY QUERY HERE IS EXPECTED TO BE FALSE: each shows
   that the lucky-guess oracle is wired, so the `Lucky` exception in the
   other files is not hiding a model in which nothing can go wrong.

   World: lucky guesses open; no adversary counterparties, no leaks. *)

query a: pkey, i: skey, e: xsk, fk: aeadkey, ft: bitstring, c: code,
      t: bitstring, p: bitstring, x: bitstring, k: aeadkey, j: aeadkey;

  (* W1. With a correct guess the attacker does get the account identity
     private key out of a bundle. *)
  attacker(i) && event(AccountSecrets(a, i, e, fk, ft)) ==> false;

  (* W2. With a correct guess the attacker does get a friendship's
     pairwise key. *)
  attacker(k) && event(FriendshipSecrets(c, t, k)) ==> false;

  (* W3. With a correct guess the attacker does hold a session key. *)
  attacker(j) && event(TypeKeys(c, p, x, k, j)) ==> false;

  (* W4. With a correct guess the typing side does accept a run the
     displaying side never accepted. *)
  event(TypeAccepted(c, p)) ==> event(DisplayAccepted(c, p)).

process
  new shut: channel;
  World(net, shut, shut, shut)
